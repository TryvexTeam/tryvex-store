NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominio publico de la tienda. Si falta, el feed de catalogo publica enlaces
# a un dominio por defecto que puede no ser el real.
NEXT_PUBLIC_URL_TIENDA=

# Token del feed de catalogo. Si NO se define, /api/feed/productos queda
# ABIERTO a internet con catalogo, precios y stock. Definir un valor largo.
FEED_TOKEN=

# --- Mercado Pago (Checkout Pro via Orders API) ---
# Access Token de la aplicacion "Tryvex Store". SOLO servidor: crea la order y
# consulta el pago. Nunca exponer al navegador ni subir al repositorio.
# Produccion: APP_USR-...  | Pruebas: TEST-...
MP_ACCESS_TOKEN=

# Clave secreta que genera el panel al guardar la configuracion de Webhooks.
# Valida la firma x-signature de cada notificacion. SOLO servidor.
MP_WEBHOOK_SECRET=

# Clave publica. Solo hace falta si se usa el SDK de Mercado Pago en el frontend.
NEXT_PUBLIC_MP_PUBLIC_KEY=

# --- Correos (Resend) ---
# Clave de la cuenta de Resend. El dominio tryvex.tech ya esta verificado
# (DKIM y SPF en el DNS), asi que los correos salen firmados. SOLO servidor.
RESEND_API_KEY=

# Remitente. Debe ser del dominio verificado.
RESEND_FROM=Tryvex Store <hola@tryvex.tech>

# A donde llegan las respuestas del cliente. El remitente vive en el dominio
# verificado y nadie lo lee; esto manda las respuestas a un buzon real.
RESEND_REPLY_TO=tryvexentreprise@gmail.com

# Logotipo de los correos. Se sirve desde el almacen publico, no desde /public:
# un correo se abre meses despues y la ruta del sitio puede cambiar.
CORREO_LOGO_URL=https://supabase.srv1877698.hstgr.cloud/storage/v1/object/public/productos/marca/tryvex-correo.png

# --- Avisos push del panel (web push) ---
# Se generan con `npx web-push generate-vapid-keys`. La publica viaja al
# navegador; la privada es SOLO servidor. Sin ellas los avisos quedan apagados.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tryvexentreprise@gmail.com

# --- Conciliacion de pagos ---
# Secreto con que pg_cron llama a /api/pagos/conciliar. El mismo valor vive en
# el Vault de Supabase (secreto `conciliar_pagos`). Sin el, el endpoint da 503.
CONCILIAR_SECRET=

# --- Aviso de ventas por Telegram (suena con la caja registradora) ---
# Token del bot, lo entrega @BotFather. SOLO servidor.
TELEGRAM_BOT_TOKEN=
# Id del grupo del equipo donde el bot publica cada venta (empieza con -100).
TELEGRAM_CHAT_ID=
