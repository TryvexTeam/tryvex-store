# Dependencias y compilación
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
/dist/
/coverage
*.tsbuildinfo
next-env.d.ts

# Variables de entorno. La plantilla sin valores sí se versiona.
.env*
!.env.example

# Vercel
.vercel

# Registros y basura del sistema
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.DS_Store
Thumbs.db
*.pem

# Material de referencia de apple.com usado para medir el diseño.
# No es nuestro y no se republica. Vive solo en el disco local.
/index.html
/styles.css
/_original/
/_imagenes_original/
/_video_original/
/_proyecto-anterior/
/site/
/svg-*.svg
/ac_video_poster_*.jpg
/large_2x*.mp4
/large_2x*.webm
*_large.jpg
*_large_2x.jpg
*_small_2x.jpg
*_large.png
*_small_2x.png
*_large_2x.png
_tools_*.py
_tools_*.mjs

# Las imágenes de la tienda sí se versionan, pese a la regla anterior.
*.png
!public/**/*.png

# Herramientas y notas de trabajo, no del proyecto
__pycache__/
*.pyc
.playwright-mcp/
.verify/
.avengers/
.claude/
